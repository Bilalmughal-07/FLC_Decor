NEXT_PUBLIC_APP_URL=http://localhost:3000
# Serverless runtime: dedicated FLC server role through Supavisor transaction
# mode. Download the project CA and URL-encode its absolute path. Never use the
# postgres migration owner or a Supabase service-role key as the app runtime.
DATABASE_URL=postgresql://flc_app_server.PROJECT_REF:REPLACE_WITH_SECRET@REGION.pooler.supabase.com:6543/postgres?schema=public&sslmode=verify-full&sslrootcert=URL_ENCODED_ABSOLUTE_CA_PATH
DATABASE_CONNECTION_MODE=serverless
DATABASE_POOL_MAX=1
# Prisma CLI/migrations: direct, non-transaction-pooled connection only.
DIRECT_DATABASE_URL=postgresql://postgres:REPLACE_WITH_SECRET@db.PROJECT_REF.supabase.co:5432/postgres?schema=public&sslmode=verify-full&sslrootcert=URL_ENCODED_ABSOLUTE_CA_PATH
# Prisma loads .env by default. Set PRISMA_ENV_FILE only to select an explicit,
# uncommitted migration environment file; .env.local is never loaded implicitly.
# PRISMA_ENV_FILE=.env.migration.local
DEMO_CHECKOUT_ENABLED=true
ADMIN_AUTH_RUNTIME=database
# Separate 32-byte AES key (64 hex characters or base64) for encrypted MFA secrets.
AUTH_FIELD_ENCRYPTION_KEY=NOT_CONFIGURED
# One-time local bootstrap flags. Set only for the bootstrap command, then clear them.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_ENV=NOT_CONFIGURED
ADMIN_BOOTSTRAP_CONFIRM=NOT_CONFIGURED
INITIAL_ADMIN_EMAIL=NOT_CONFIGURED
INITIAL_ADMIN_PASSWORD=NOT_CONFIGURED
ADMIN_PREVIEW_ENABLED=true
# Public owner-confirmed contact details are centralized in lib/business-contact.ts.
SESSION_SECRET=replace-with-a-long-random-development-secret
CHECKOUT_RUNTIME=demo
CATALOG_RUNTIME=sample
# Local database checkout only: explicitly set synthetic-zero and a random 32-byte key.
CHECKOUT_TOTALS_MODE=NOT_CONFIGURED
CHECKOUT_FIELD_ENCRYPTION_KEY=NOT_CONFIGURED
# Customer auth: use `demo` only for local synthetic tests. Use `supabase` for
# real customer sessions after configuring the project redirect allowlist.
AUTH_RUNTIME=demo
NEXT_PUBLIC_SUPABASE_URL=NOT_CONFIGURED
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=NOT_CONFIGURED
GUEST_TRACKING_ENABLED=false
GUEST_TRACKING_DELIVERY=NOT_CONFIGURED
PAYMENT_PROVIDER_RUNTIME=NOT_CONFIGURED
# Non-production preview only. `development-memory` never sends externally.
NOTIFICATION_RUNTIME=NOT_CONFIGURED
# Reserved for a future approved provider adapter; currently unused by code.
NOTIFICATION_PROVIDER=NOT_CONFIGURED
NOTIFICATION_PROVIDER_API_KEY=NOT_CONFIGURED
NOTIFICATION_FROM_EMAIL=NOT_CONFIGURED
NOTIFICATION_WEBHOOK_SECRET=NOT_CONFIGURED
MEDIA_STORAGE_RUNTIME=disabled
# Cloudflare R2 is server-only. Keep disabled until a private bucket and scoped credentials exist.
R2_ACCOUNT_ID=NOT_CONFIGURED
R2_ACCESS_KEY_ID=NOT_CONFIGURED
R2_SECRET_ACCESS_KEY=NOT_CONFIGURED
R2_BUCKET_NAME=NOT_CONFIGURED
R2_ENDPOINT=NOT_CONFIGURED
# Optional HTTPS Worker/CDN URL that exposes only the public/ prefix. Leave unset to use the state-checked app media route.
R2_PUBLIC_BASE_URL=NOT_CONFIGURED
TRUSTED_PROXY_CIDRS=NOT_CONFIGURED
