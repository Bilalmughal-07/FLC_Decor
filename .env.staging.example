# Sanitized staging-only template. Copy to an untracked file such as
# .env.staging.local, replace placeholders through a password manager or local
# secrets manager, and set STAGING_ENV_FILE to that path only for preflight.
SUPABASE_PROJECT_REF=ltcgiquvrplfrbojbbbb

# Prisma 7 migration/status URL. The password and CA path must be URL-encoded.
DIRECT_DATABASE_URL=postgresql://postgres:REPLACE_WITH_URL_ENCODED_SECRET@db.ltcgiquvrplfrbojbbbb.supabase.co:5432/postgres?schema=public&sslmode=verify-full&sslrootcert=URL_ENCODED_ABSOLUTE_CA_PATH

# psql URL for the pre-migration guard and privileged verification. psql does
# not understand Prisma's schema query parameter, so it is intentionally absent.
DIRECT_PSQL_URL=postgresql://postgres:REPLACE_WITH_URL_ENCODED_SECRET@db.ltcgiquvrplfrbojbbbb.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=URL_ENCODED_ABSOLUTE_CA_PATH

# Shared Supavisor transaction mode for serverless runtime. Replace REGION with
# the exact host from the staging project's Connect panel.
DATABASE_URL=postgresql://flc_app_server.ltcgiquvrplfrbojbbbb:REPLACE_WITH_URL_ENCODED_SECRET@REGION.pooler.supabase.com:6543/postgres?schema=public&sslmode=verify-full&sslrootcert=URL_ENCODED_ABSOLUTE_CA_PATH
DATABASE_CONNECTION_MODE=serverless
DATABASE_POOL_MAX=1

# Customer Auth must also point to staging if enabled during staging tests.
NEXT_PUBLIC_SUPABASE_URL=https://ltcgiquvrplfrbojbbbb.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_STAGING_PUBLISHABLE_KEY
