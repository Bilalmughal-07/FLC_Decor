{
  "name": "fahad-laser-flc-decor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run tests --exclude tests/integration/** --passWithNoTests",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:migrations:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-supabase-remediation-local.ps1",
    "staging:validate-target": "tsx scripts/validate-supabase-staging-target.ts",
    "test:e2e": "playwright test",
    "qa:theme": "node scripts/qa-theme-audit.mjs",
    "test:r2": "tsx scripts/verify-r2.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "admin:bootstrap:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bootstrap-admin-local.ps1",
    "security:audit": "npm audit --audit-level=high",
    "db:validate": "prisma validate && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "build:check": "next build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1157.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "html2canvas": "^1.4.1",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "dotenv": "^18.0.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.4.3",
    "prisma": "^7.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vitest": "^5.0.5"
  }
}
